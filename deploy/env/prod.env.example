# Install as /etc/task-workbench/runtime.env owner root:root mode 0600.
# systemd EnvironmentFile syntax, not an executable shell script.
SPRING_PROFILES_ACTIVE=prod
TASK_DB_URL=jdbc:mysql://db.internal:3306/task_workbench?sslMode=VERIFY_IDENTITY&serverTimezone=Asia/Shanghai
TASK_DB_USER=task_app
TASK_DB_PASSWORD=
TASK_STORAGE_ROOT=/var/lib/task-workbench/attachments
TASK_TOTP_ENCRYPTION_KEY=
TASK_BOOTSTRAP_PASSWORD=
TASK_FLYWAY_ENABLED=false
TASK_JOBS_ENABLED=true
TASK_SECURE_COOKIE=true
TASK_BIND_ADDRESS=127.0.0.1
TASK_PORT=8080
# Absolute path to reviewed malware scanner; empty/unavailable must quarantine.
TASK_SCANNER_COMMAND=
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=native
SERVER_SERVLET_SESSION_COOKIE_SECURE=true
SERVER_SERVLET_SESSION_COOKIE_HTTP_ONLY=true
SERVER_SERVLET_SESSION_COOKIE_SAME_SITE=lax
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=11MB
MANAGEMENT_SERVER_ADDRESS=127.0.0.1
MANAGEMENT_SERVER_PORT=8081
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never

# Install a licensed Chinese TTF such as Noto Sans SC; PDF fails closed if absent.
TASK_EXPORT_FONT=/opt/task-workbench/fonts/NotoSansSC-Regular.ttf
