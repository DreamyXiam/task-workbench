# Documentation only: no production defaults and no committed credentials.
# Set these in the calling process; Spring does not automatically load this file.
SPRING_PROFILES_ACTIVE=prod
TASK_DB_URL=jdbc:mysql://127.0.0.1:3306/task_workbench?sslMode=VERIFY_IDENTITY&serverTimezone=Asia/Shanghai
TASK_DB_USER=
TASK_DB_PASSWORD=
TASK_STORAGE_ROOT=/var/lib/task-workbench/attachments
TASK_TOTP_ENCRYPTION_KEY=
TASK_FLYWAY_ENABLED=false
TASK_SECURE_COOKIE=true
TASK_SCANNER_COMMAND=
TASK_BOOTSTRAP_PASSWORD=
# Never put migration credentials into the runtime environment.

# PDF export: trusted local Chinese TTF font; never a user-provided upload
TASK_EXPORT_FONT=
